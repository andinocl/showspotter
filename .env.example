# Copy to .env and fill in. .env is git-ignored; never commit real values.

# Public origin of the site and the WebAuthn relying-party ID (bare hostname).
# Passkeys are bound to the RP ID, so pick it before real users enroll.
APP_ORIGIN=https://shows.example.com
WEBAUTHN_RP_ID=shows.example.com

# MariaDB reachable from the app container (see docs/DEPLOY.md).
DATABASE_URL=mysql://showspotter:CHANGE_ME@mariadb:3306/showspotter

# openssl rand -base64 48
SESSION_SECRET=CHANGE_ME_TO_A_LONG_RANDOM_STRING

# Name of the existing Docker network the MariaDB container is attached to.
MARIADB_DOCKER_NETWORK=CHANGE_ME
# Host port the app listens on (bind to loopback; your reverse proxy fronts it).
APP_PORT=3000

